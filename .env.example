# MoleCraft Environment Configuration
# Copy this file to .env and fill in your values

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# External APIs
PUBMED_API_KEY=your-pubmed-api-key
TAVILY_API_KEY=your-tavily-api-key
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key

# ChromaDB (Vector Store) - Get from https://trychroma.com
CHROMA_HOST=api.trychroma.com
CHROMA_TENANT=your-tenant-id
CHROMA_DATABASE=molecraft
CHROMA_COLLECTION=molecraft
CHROMA_API_KEY=your-chroma-api-key

# Docking
VINA_PATH=vina
GNINA_PATH=gnina

# Diffusion Models
DIFFDOCK_MODEL_PATH=/app/models/diffdock/checkpoints

# Embedding Provider (local or openai)
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Model API URLs (for web frontend)
MODEL_API_URL=http://affinity-predictor:8001
GENERATIVE_API_URL=http://molecule-generator:8000
GENERATIVE_DIFFUSION_API_URL=http://generative-diffusion:8000
RAG_API_URL=http://rag-pipeline:8002
DOCKING_API_URL=http://docking:8003
PROTEO_API_URL=http://proteochem:8004
FOUNDATION_API_URL=http://foundation-models:8005
ADMET_API_URL=http://admet-ml:8006
MOLECULE_QA_API_URL=http://molecule-qa:8007
INGESTION_API_URL=http://ingestion-service:8011
OMICS_API_URL=http://omics-discovery:8010
ANTIBODY_API_URL=http://antibody-design:8020
PROTAC_API_URL=http://protac-design:8021
RNA_API_URL=http://rna-design:8022
PEPTIDE_API_URL=http://peptide-design:8023
CLINICAL_API_URL=http://clinical-trial:8030
LAB_API_URL=http://lab-automation:8040
PHYSICS_API_URL=http://physics-sim:8050
PATENT_API_URL=http://patent-ip:8060